{
  "name": "@pify/plan-mode",
  "version": "0.4.1",
  "description": "Read-only planning mode for pi with an explicit approve-then-execute gate: enforced tool policy, plan files, approach options, fresh-session handoff",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pify",
    "plan-mode"
  ],
  "homepage": "https://github.com/pifydev/plan-mode#readme",
  "bugs": {
    "url": "https://github.com/pifydev/plan-mode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pifydev/plan-mode.git"
  },
  "license": "MIT",
  "author": "Pify maintainers",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/plan-mode.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.10.2",
    "typebox": "^1.1.38",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
